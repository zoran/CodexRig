{
  "name": "codexrig",
  "version": "4.4.1",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "scripts": {
    "auth:check": "node scripts/verify/identity-access.mjs",
    "localization:check": "node scripts/verify/localization.mjs",
    "license:check": "node scripts/verify/licensing.mjs",
    "tenancy:check": "node scripts/verify/tenant-isolation.mjs",
    "framework:reset": "node .agents/skills/reset-framework/scripts/reset-framework.mjs",
    "framework:publish": "node .agents/skills/reset-framework/scripts/publish-framework.mjs",
    "framework:doctor": "node scripts/framework/framework-doctor.mjs",
    "framework:upgrade": "node scripts/framework/framework-upgrade.mjs",
    "framework:version": "node scripts/framework/framework-version.mjs",
    "compatibility:matrix": "node scripts/framework/compatibility-matrix.mjs",
    "platform:detect": "node scripts/platform/detect-platform.mjs",
    "platform:configure": "node scripts/platform/configure-platform.mjs",
    "codex:start": "bash scripts/setup/start-codex.sh",
    "codex:validate": "node scripts/setup/validate-codex-model-policy.mjs",
    "context:test": "node --test scripts/context/context-lifecycle.test.mjs scripts/context/portable-context-contract.test.mjs",
    "handover:create": "node scripts/context/critical-budget-handover.mjs create",
    "handover:receive": "node scripts/context/critical-budget-handover.mjs receive",
    "handover:acknowledge": "node scripts/context/critical-budget-handover.mjs acknowledge",
    "deps:install": "node scripts/deps/install-compatible.mjs",
    "deps:preflight": "node scripts/deps/verify-pnpm-execution-policy.mjs",
    "deps:report": "node scripts/deps/report.mjs",
    "deps:update": "node scripts/deps/update.mjs",
    "deps:update:patch": "node scripts/deps/update.mjs --level patch",
    "docs:check": "node scripts/verify/docs.mjs",
    "format": "node scripts/verify/format-project.mjs --write",
    "format:check": "node scripts/verify/format-project.mjs --check",
    "goal:new": "node scripts/goals/goal-publication-precondition.mjs",
    "hooks:install": "bash scripts/setup/install-git-hooks.sh",
    "setup": "bash scripts/setup/check-prereqs.sh --codex && node scripts/setup/validate-codex-model-policy.mjs && node scripts/verify/docs.mjs && node scripts/verify/identity-access.mjs && node scripts/verify/tenant-isolation.mjs && node scripts/verify/localization.mjs && node scripts/verify/licensing.mjs && node scripts/verify/secrets.mjs && bash scripts/setup/install-git-hooks.sh",
    "stack:detect": "node scripts/stack/stack-detector.mjs",
    "project:export": "bash scripts/setup/export-project.sh",
    "repo:housekeeping": "node scripts/goals/repository-housekeeping.mjs",
    "verify": "node scripts/verify/adaptive.mjs --mode full",
    "verify:changed": "node scripts/verify/adaptive.mjs --mode repo",
    "verify:external": "node scripts/verify/external.mjs",
    "verify:pre-push": "bash scripts/verify/pre-push.sh",
    "web:update-sitemap-lastmod": "node scripts/web/update-sitemap-lastmod.mjs",
    "worktree:status": "node scripts/repository/worktree-recovery-cli.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
